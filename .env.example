# ── Credenciais ──────────────────────────────────────────────────────────────
# Três URLs, três papéis, e só uma delas escreve. As senhas dos dois papéis de
# leitura estão no ../keeper-wiki-db/.env, criadas por init/002-papeis.sh.

# A API, dentro da rede do Docker (host `db`). Papel keeper_api: SELECT no gk.
DATABASE_URL_DOCKER=postgresql://keeper_api:SENHA_API@db:5432/porti

# A API rodando direto no host, sem container.
DATABASE_URL=postgresql://keeper_api:SENHA_API@localhost:5432/porti

# Consultas do Claude Code (scripts/consulta.sh). Papel keeper_claude: só lê.
DATABASE_URL_LEITURA=postgresql://keeper_claude:SENHA_CLAUDE@localhost:5432/porti

# Dono do banco. Usado SÓ por scripts/aplica-schema.sh e scripts/importa.py.
# Nunca coloque esta URL em DATABASE_URL.
DATABASE_URL_DONO=postgresql://porti:SENHA_POSTGRES@localhost:5432/porti

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000

# Origens do CORS, em JSON. Vazio quando o keeper-wiki-fnd consome a API só no
# build (adapter-static), que é o caso hoje: aí não há fetch do navegador.
CORS_ORIGENS=[]
